# Copy this file to .env.local and fill in your Supabase project values
# (Supabase dashboard -> Project Settings -> API).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Use the PUBLISHABLE key (sb_publishable_…) — or the legacy "anon public" key.
# NEVER the Secret key: everything here is built into the public website.
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key
